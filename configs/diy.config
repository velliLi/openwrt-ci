# ============================================
# 目标平台 - IPQ60XX
# ============================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y

# ============================================
# 设备列表
# ============================================
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_anysafe_e1=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_cmiot_ax18=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_glinet_gl-ax1800=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_glinet_gl-axt1800=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v1=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_linksys_mr7350=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_linksys_mr7500=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_qihoo_360v6=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_xiaomi_ax1800=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# ============================================
# 基础系统优化
# ============================================
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=4
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_ip-full=y
CONFIG_NSS_FIRMWARE_VERSION_12_2=y

# ============================================
# 网络基础 - NFTables
# ============================================
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_xtables-nft=y
CONFIG_PACKAGE_ca-bundle=y

# ============================================
# 代理 - PassWall2 (Sing-Box + NFTables 透明代理)
# ============================================
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox=y
CONFIG_PCRE2_JIT_ENABLED=y

# ============================================
# Lucky (Stun/DDNS/WebPanel)
# ============================================
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y

# ============================================
# 主题与界面
# ============================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ============================================
# 系统应用
# ============================================
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-wol=y

# ============================================
# VPN - WireGuard
# ============================================
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ============================================
# 禁用 USB 相关
# ============================================
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_automount=n
CONFIG_PACKAGE_kmod-usb-dwc3=n
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-common=n
CONFIG_USB_SUPPORT=n

# ============================================
# 禁用 WiFi 驱动
# ============================================
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_hostapd-common=n

# ============================================
# 禁用 各机型 WiFi 固件 (使用 PACKAGE 而非 DEFAULT 以确保生效)
# ============================================
CONFIG_PACKAGE_ipq-wifi-anysafe_e1=n
CONFIG_PACKAGE_ipq-wifi-cmiot_ax18=n
CONFIG_PACKAGE_ipq-wifi-glinet_gl-ax1800=n
CONFIG_PACKAGE_ipq-wifi-glinet_gl-axt1800=n
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-02=n
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01=n
CONFIG_PACKAGE_ipq-wifi-link_nn6000=n
CONFIG_PACKAGE_ipq-wifi-linksys_mr7350=n
CONFIG_PACKAGE_ipq-wifi-linksys_mr7500=n
CONFIG_PACKAGE_ipq-wifi-qihoo_360v6=n
CONFIG_PACKAGE_ipq-wifi-redmi_ax5=n
CONFIG_PACKAGE_ipq-wifi-redmi_ax5-jdcloud=n
CONFIG_PACKAGE_ipq-wifi-xiaomi_ax1800=n
CONFIG_PACKAGE_ipq-wifi-zn_m2=n

# ============================================
# 禁用 值守式升级
# ============================================
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
